# Names only. Real values live in EAS environment variables (expo.dev → Project → Environment variables).
# Local development: `npx eas-cli@latest env:pull --environment development` writes an untracked .env.local.
# docs/spec/01-overview-foundation.md §4

# Public — bundled into the app. Never put a secret behind an EXPO_PUBLIC_ name (CI blocks SECRET/SERVICE/PRIVATE/TOKEN).
EXPO_PUBLIC_APP_ENV=development
EXPO_PUBLIC_API_BASE_URL=http://10.0.2.2:3000/api/v1
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
EXPO_PUBLIC_MAP_STYLE_URL=https://tiles.openfreemap.org/styles/liberty
EXPO_PUBLIC_SENTRY_DSN=
# Sign-in by SMS code needs an SMS gateway in Supabase. Email codes always work.
EXPO_PUBLIC_PHONE_SIGN_IN=false
EXPO_PUBLIC_GOOGLE_SIGN_IN=false
EXPO_PUBLIC_TERMS_URL=
EXPO_PUBLIC_PRIVACY_URL=

# Build-time only (EAS env with visibility "secret"; not readable by the app at runtime)
EAS_PROJECT_ID=
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=
