      "port": 3005
    },
    {
      "name": "web-local",
      "runtimeExecutable": "node",
      "runtimeArgs": [
        "scripts/with-local-backend.mjs",
        "npx",
        "expo",
        "start",
        "--web",
        "--port",
        "8082"
      ],
      "port": 8082
    }
  ]
}
